# Instruções para gerar e plotar curvas de distribuição Weibull com diferentes parâmetros usando ggplot2
# 1. Carregar as bibliotecas necessárias
library(ggplot2)
library(dplyr)
# 2. Definir os parâmetros para as distribuições Weibull
#    - 'shape' (forma) e 'scale' (escala) são os parâmetros da distribuição Weibull
params <- data.frame(
shape = c(1, 2, 5, 2),
scale = c(1, 1, 1, 2)
)
# 3. Gerar dados para as curvas de distribuição Weibull
#    - Criar uma sequência de valores x para plotar as curvas
x <- seq(0, 5, length.out = 1000)
#    - Criar um dataframe para armazenar os dados das curvas
data <- data.frame()
#    - Iterar sobre os parâmetros e calcular a densidade da distribuição Weibull para cada conjunto de parâmetros
for (i in 1:nrow(params)) {
shape <- params$shape[i]
scale <- params$scale[i]
#    - Calcular a densidade da distribuição Weibull usando a função 'dweibull'
y <- dweibull(x, shape = shape, scale = scale)
#    - Criar um dataframe temporário para armazenar os dados da curva atual
temp_data <- data.frame(x = x, y = y, shape = as.factor(shape), scale = as.factor(scale))
#    - Adicionar os dados da curva atual ao dataframe principal
data <- rbind(data, temp_data)
}
# 4. Criar o gráfico usando ggplot2
#    - Criar um gráfico de linhas com 'x' no eixo x e 'y' no eixo y
#    - Usar 'shape' e 'scale' para diferenciar as curvas por cor e linha
ggplot(data, aes(x = x, y = y, color = shape, linetype = scale)) +
geom_line() +
#    - Adicionar títulos e rótulos aos eixos
labs(
title = "Curvas de Distribuição Weibull com Diferentes Parâmetros",
x = "x",
y = "Densidade",
color = "Forma",
linetype = "Escala"
) +
#    - Definir o tema do gráfico
theme_minimal()
# 5. Exibir o gráfico
# Instruções para gerar e plotar curvas de distribuição Weibull com diferentes parâmetros usando ggplot2
# 1. Carregar as bibliotecas necessárias
library(ggplot2)
library(dplyr)
# 2. Definir os parâmetros para as distribuições Weibull
#    - 'shape' (forma) e 'scale' (escala) são os parâmetros da distribuição Weibull
params <- data.frame(
shape = c(1, 2, 5, 2),
scale = c(1, 1, 1, 2)
)
# 3. Gerar dados para as curvas de distribuição Weibull
#    - Criar uma sequência de valores x para plotar as curvas
x <- seq(0, 5, length.out = 1000)
#    - Criar um dataframe para armazenar os dados das curvas
data <- data.frame()
#    - Iterar sobre os parâmetros e calcular a densidade da distribuição Weibull para cada conjunto de parâmetros
for (i in 1:nrow(params)) {
shape <- params$shape[i]
scale <- params$scale[i]
#    - Calcular a densidade da distribuição Weibull usando a função 'dweibull'
y <- dweibull(x, shape = shape, scale = scale)
#    - Criar um dataframe temporário para armazenar os dados da curva atual
temp_data <- data.frame(x = x, y = y, shape = as.factor(shape), scale = as.factor(scale))
#    - Adicionar os dados da curva atual ao dataframe principal
data <- rbind(data, temp_data)
}
# 4. Criar o gráfico usando ggplot2
#    - Criar um gráfico de linhas com 'x' no eixo x e 'y' no eixo y
#    - Usar 'shape' e 'scale' para diferenciar as curvas por cor e linha
ggplot(data, aes(x = x, y = y, color = shape, linetype = scale)) +
geom_line() +
#    - Adicionar títulos e rótulos aos eixos
labs(
#title = "Curvas de Distribuição Weibull com Diferentes Parâmetros",
x = "x",
y = "Densidade",
color = "Forma",
linetype = "Escala"
) +
#    - Definir o tema do gráfico
theme_minimal()
# 5. Exibir o gráfico
